# Use '#' for comments

JOY_INPUT_PATH "/dev/input/event2"

# Map custom button names to button keycodes
[BUTTON DECLARATION]
TM_BUTTON_1 304
TM_BUTTON_2 305
TM_BUTTON_3 306
TM_BUTTON_4 307
TM_BUTTON_5 308
TM_BUTTON_6 309
TM_BUTTON_7 310
TM_BUTTON_8 311
TM_BUTTON_LEFT 312
TM_BUTTON_RIGHT 313
TM_BUTTON_JOY1 314
TM_BUTTON_JOY5 315

# Map gamepad buttons to linux input-event-codes
[BUTTON MAPPING]
TM_BUTTON_1 keyboard.KEY_SPACE
TM_BUTTON_2 mouse.BTN_LEFT.hold
TM_BUTTON_2.r mouse.BTN_LEFT.release
TM_BUTTON_3 mouse.BTN_RIGHT
TM_BUTTON_4 mouse.BTN_MIDDLE

# Alt-Tab one to the left
TM_BUTTON_5 KEY_LEFTALT.hold KEY_LEFTSHIFT.hold KEY_TAB KEY_LEFTSHIFT.release KEY_LEFTALT.release
TM_BUTTON_7 KEY_LEFTALT.hold KEY_TAB KEY_LEFTALT.release
TM_BUTTON_8 KEY_PLAYPAUSE
TM_BUTTON_LEFT KEY_LEFTALT.hold KEY_TAB
TM_BUTTON_RIGHT KEY_LEFTALT.release

[AXIS MAPPING]
